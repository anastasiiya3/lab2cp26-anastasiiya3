#include <iostream>
#include <thread>
#include <chrono>
#include <mutex>

using namespace std;

mutex mtx;

// Рух золотих рибок по осі X
void goldFish(int id, int maxX, int V)
{
    for (int x = 0; x <= maxX; x++)
    {
        {
            lock_guard<mutex> lock(mtx);
            cout << "GoldFish #" << id << " -> X = " << x << endl;
        }
        this_thread::sleep_for(chrono::milliseconds(V));
    }
}

// Рух гуппі по осі Y
void guppy(int id, int maxY, int V)
{
    for (int y = 0; y <= maxY; y++)
    {
        {
            lock_guard<mutex> lock(mtx);
            cout << "Guppy #" << id << " -> Y = " << y << endl;
        }
        this_thread::sleep_for(chrono::milliseconds(V));
    }
}

int main()
{
    int V = 300;      // швидкість руху (менше = швидше)
    int maxX = 20;
    int maxY = 15;

    thread gold1(goldFish, 1, maxX, V);
    thread gold2(goldFish, 2, maxX, V);

    thread guppy1(guppy, 1, maxY, V);
    thread guppy2(guppy, 2, maxY, V);

    gold1.join();
    gold2.join();
    guppy1.join();
    guppy2.join();

    cout << "Simulation finished!" << endl;

    return 0;
}
